.env
.DS_Store
.venv/
.conda/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
data/inputs/*
!data/inputs/.gitkeep
data/results/*
!data/results/.gitkeep
# Reviewer decisions are local audit records, never committed.
data/human_review/*
!data/human_review/.gitkeep
# M4 reviewer input is local working state; the built artifact is what ships.
data/explanation_quality/*
!data/explanation_quality/.gitkeep
data/competition/*
!data/competition/.gitignore
!data/competition/README.md
reports/*
!reports/v045_demo_bundle/
!reports/v045_demo_bundle/**
!reports/final_status/
!reports/final_status/**
!reports/retrieval_40_baseline/
!reports/retrieval_40_baseline/**
!reports/retriever_v3/
!reports/retriever_v3/**
!reports/.gitkeep
!reports/llm_reranker_pilot/
!reports/llm_reranker_pilot/**
reports/llm_reranker_pilot/*.log
!reports/oracle_gold_audit/
!reports/oracle_gold_audit/**
!reports/v046_dynamic_model_runtime/
!reports/v046_dynamic_model_runtime/**
!reports/v04_pr_b/
reports/v04_pr_b/*
!reports/v04_pr_b/core_features/
!reports/v04_pr_b/core_features/*.json
models/*
!models/.gitkeep
!models/retriever_v3/
!models/retriever_v3/ltr_v3.txt
# The Role-D V2 runtime package: a 300 KB LightGBM text booster plus its
# manifests, rebuilt only under the frozen classifier hash. This is the product's
# model identity, not a model bulk dump.
!models/role_d_v2/
!models/role_d_v2/model.txt
!models/role_d_v2/*.json
!models/role_d_v2/SHA256SUMS.txt
*.pkl
*.joblib
*.onnx
*.bin
*.ckpt
*.docx

# Local, single-prospectus validation harness (not part of the product surface).
scripts/run_jingfa_full_demo.py

# Local Oracle/modeling caches and ephemeral test workdirs.
.pytest-oracle-*/
data/cache/
# Licensed/local prospectuses are never repository artifacts.
data/local/
