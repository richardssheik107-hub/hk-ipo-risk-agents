{
  "protocol_version": "v045_competition_metric_protocol_v2_existing_gold_only",
  "status": "FROZEN_BEFORE_VALIDATION_REEVALUATION",
  "supersedes": "v045_competition_metric_protocol_v1",
  "gold_policy": {
    "existing_expert_gold_only": true,
    "new_manual_annotations_allowed": false,
    "existing_gold_modification_allowed": false,
    "unjudged_treated_as_negative": false,
    "manual_evidence_regrouping_allowed": false,
    "allow_deterministic_schema_normalization": true,
    "allow_exact_duplicate_anchor_deduplication": true,
    "annotation_inventory": 101,
    "valid_annotations": 100,
    "official_materialized": 98
  },
  "split_policy": {
    "development": "2020-2023",
    "validation": "2024",
    "blind": "2025",
    "development_remediation_allowed": true,
    "validation_post_hoc_tuning_allowed": false,
    "blind_outcome_access_allowed": false,
    "final_development_scope": "all_evaluable_existing_development_expert_gold",
    "final_validation_scope": "all_evaluable_existing_validation_expert_gold"
  },
  "risk_extraction": {
    "primary_metric": "existing_gold_official_aligned_accuracy",
    "official_threshold": 0.8,
    "project_target": 0.85,
    "competition_priority_families": [
      "redemption_rights",
      "related_party_transaction",
      "customer_concentration",
      "supplier_concentration",
      "cash_burn_pressure"
    ],
    "evaluate_only_when_existing_gold_supports_family": true,
    "zero_support_status": "NOT_EVALUABLE_FROM_EXISTING_GOLD",
    "precision_requires_exhaustive_existing_judgment": true,
    "macro_f1_requires_exhaustive_existing_judgment": true,
    "unsupported_precision_or_f1_status": "NOT_AVAILABLE_FROM_EXISTING_GOLD"
  },
  "evidence": {
    "primary_metric": "existing_gold_evidence_coverage_recall",
    "official_threshold": 0.85,
    "project_target": 0.88,
    "fixed_top_k_for_primary_metric": null,
    "manual_new_evidence_allowed": false,
    "manual_semantic_regrouping_allowed": false,
    "candidate_recall_at_20_target": 0.95,
    "reranked_recall_at_10_target": 0.9,
    "secondary_rank_metrics": [1, 3, 5, 10, 20]
  },
  "optimization_policy": {
    "allowed_on_development": [
      "retriever_code",
      "ranking_code",
      "llm_prompt",
      "structured_extraction",
      "schema_normalization",
      "riskitem_reconciliation",
      "verifier"
    ],
    "gold_expansion_allowed": false,
    "new_risk_annotation_allowed": false
  },
  "traceability": {
    "official_threshold": 1.0,
    "development_real_llm_required": true,
    "final_matrix_required": true
  },
  "explanation_quality": {
    "dimensions": [
      "evidence_grounding",
      "logical_consistency",
      "conflict_handling",
      "recheck_quality",
      "final_conclusion"
    ],
    "scale_min": 1,
    "scale_max": 5,
    "minimum_human_reviewers": 2,
    "mean_score_target": 4.0,
    "minimum_case_score": 3.0,
    "llm_reviewer_may_be_sole_reviewer": false
  },
  "post_listing": {
    "required_horizons": [1, 5, 20, 60],
    "primary_horizon": 5,
    "significant_drop_5d_definition": "return_5d <= -0.10",
    "robustness_definition": "development_return_5d_bottom_20_percent",
    "five_day_metrics": [
      "precision",
      "recall",
      "f1",
      "pr_auc",
      "roc_auc",
      "top_10pct_hit_rate",
      "top_20pct_hit_rate",
      "base_prevalence"
    ],
    "official_absolute_metric_threshold_defined": false
  }
}