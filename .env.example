# Optional runtime overrides. Do not store secrets in this file.
IPO_RISK_CONFIG=configs/mock.yaml
IPO_RISK_LOG_LEVEL=INFO
# Optional local path to the competition data root. Keep the raw data outside Git.
IPO_RISK_COMPETITION_DATA_ROOT=

# LLM integration.
# Supported registered providers: mock, unavailable, openai_compatible, openai_responses.
# The two remote providers currently require API key + base URL + model.
# Keep real credentials in the local environment / secret manager, never in Git.
IPO_RISK_LLM_PROVIDER=mock
IPO_RISK_LLM_API_KEY=
IPO_RISK_LLM_BASE_URL=
IPO_RISK_LLM_MODEL=
IPO_RISK_LLM_TIMEOUT_SECONDS=60
IPO_RISK_LLM_MAX_RETRIES=2

# Optional governed v0.4 product channels.
# PR-F must point only at the original frozen/hash-bound local handoff; leave empty
# when it is unavailable. Never retrain merely to populate this path.
IPO_RISK_PR_F_RUN_DIR=
IPO_RISK_MARKET_FEATURE_DIR=reports/v04_pr_b/core_features
IPO_RISK_MARKET_OFFICIAL_BRIDGE=data/catalog/ipo_official_master_bridge.csv
IPO_RISK_MARKET_EXTENDED_READINESS=
