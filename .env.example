# Optional runtime overrides. Do not store secrets in this file.
IPO_RISK_CONFIG=configs/mock.yaml
IPO_RISK_LOG_LEVEL=INFO
# Optional local path to the competition data root. Keep the raw data outside Git.
IPO_RISK_COMPETITION_DATA_ROOT=
# v0.3 LLM integration. Obtain values from the provider console; never commit keys.
IPO_RISK_LLM_PROVIDER=mock
IPO_RISK_LLM_API_KEY=
IPO_RISK_LLM_BASE_URL=
IPO_RISK_LLM_MODEL=
IPO_RISK_LLM_TIMEOUT_SECONDS=60
IPO_RISK_LLM_MAX_RETRIES=2
